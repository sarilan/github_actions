# Copier ce fichier en `.env` et remplir les valeurs. Le fichier `.env` n'est jamais commité.

# --- Airtable (outils/airtable, outils/courrier --airtable, outils/rapport) ---
# Jeton d'accès personnel (Personal Access Token) avec les portées :
#   schema.bases:read, schema.bases:write, data.records:read, data.records:write
AIRTABLE_API_KEY=
# Identifiant de l'espace de travail (commence par "wsp"), nécessaire pour créer la base.
AIRTABLE_WORKSPACE_ID=
# Identifiant de la base (commence par "app"). Rempli automatiquement par create_base.py
# dans le fichier outils/airtable/.base_id, ou à renseigner ici si la base existe déjà.
AIRTABLE_BASE_ID=

# --- Formspree (site/index.html) ---
# Point de terminaison du formulaire, ex. https://formspree.io/f/xxxxxxxx
FORMSPREE_ENDPOINT=

# --- Site (ads/campagne-google-ads.csv) ---
SITE_URL=https://www.exemple.fr

# --- Coordonnées affichées dans le rapport mensuel (outils/rapport) ---
MANDATAIRE_EMAIL=
MANDATAIRE_TELEPHONE=
